.DS_Store
*.swp
*.o

# Local decrypted code-signing key material — NEVER commit (only meshsign.p12.enc is tracked)
signing/key.pem
signing/meshsign.p12
signing/cert.pem
signing/cert.conf
signing/README.md.local-master

# Built installer package -- a build artifact, regenerated by installer/pkg/build-pkg.sh.
# It was tracked by accident and changed on every build, so each rebuild showed up
# as a binary diff. The signed and notarized one must never be committed either:
# it carries a Developer ID signature and belongs in a release, not in history.
installer/pkg/MeshAgent-Installer.pkg

# Stale packages from the July pkgbuild experiments, superseded by installer/pkg/.
/MeshAgent.pkg
/MeshAgent-fresh.pkg
/MeshAgent-loginfix.pkg
