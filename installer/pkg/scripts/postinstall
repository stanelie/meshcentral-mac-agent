#!/bin/bash
# MeshAgent installer package -- postinstall.
#
# This package carries NO payload on purpose. It fetches the hosted installer and
# runs it, so there is exactly one source of truth for what an install does.
#
# It also keeps notarization simple: a package with no Mach-O in it has nothing
# for Apple to object to, and -- more importantly -- the agent binaries keep
# their existing signing identity. Re-signing them with a Developer ID would
# change their designated requirement, which is what the Screen Recording and
# Accessibility grants are pinned to, and every Mac in the fleet would have to
# approve them again.
#
# IMPORTANT: Installer.app must never be left waiting on a dialog. Measured
# 2026-10-14: running the walkthrough inline left `installer` blocked on an
# osascript prompt, and it exited while the dialog was still on screen -- the
# install "finished" with the prompts orphaned and the log cut off mid-write. So
# the install runs non-interactively here, and the permission walkthrough is
# handed to launchd as a one-shot agent in the console user's session, which
# outlives this script by design.
set -u

BASE_URL="https://__HOST__"
LOG=/var/log/meshagent-pkg-install.log
exec > >(/usr/bin/tee -a "$LOG") 2>&1
echo "=== MeshAgent pkg install $(date) ==="

D="/usr/local/mesh_services/meshagent/meshagent"
TMP="$(/usr/bin/mktemp -d /tmp/meshagent-pkg.XXXXXX)"
trap '/bin/rm -rf "$TMP"' EXIT

# Who is the console user?
#
# NOT from /dev/console ownership. That is what this used to do, and it is
# unreliable: measured on a VM with user1 logged in and active,
#     stat -f %Su /dev/console  ->  root
#     scutil State:/Users/ConsoleUser Name  ->  user1
# With CUSER=root every block below is skipped in silence -- the permission
# walkthrough, the TCC watcher, and the per-user LaunchAgent bootstrap -- and the
# install still reports success. That is almost certainly behind more than one
# "the installer did nothing" report.
#
# SCDynamicStore is the authority (it is what the agent itself uses). Fall back
# to /dev/console only if that yields nothing, and treat root or loginwindow as
# "nobody is logged in".
CUSER=$(echo "show State:/Users/ConsoleUser" | /usr/sbin/scutil 2>/dev/null | /usr/bin/awk '/Name :/ { print $3 }')
case "$CUSER" in loginwindow|root|"") CUSER="" ;; esac
if [ -z "$CUSER" ]; then
    CUSER=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || echo "")
    case "$CUSER" in root|"") CUSER="" ;; esac
fi
if [ -n "$CUSER" ]; then CUID=$(id -u "$CUSER" 2>/dev/null || echo ""); else CUID=""; fi

tell_user() {   # best effort; no double quotes in the text
    [ -n "${CUID:-}" ] && [ "${CUSER:-root}" != "root" ] || return 0
    /bin/launchctl asuser "$CUID" /usr/bin/sudo -u "$CUSER" /usr/bin/osascript -e \
        "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with title \"MeshAgent setup\" with icon stop" \
        >/dev/null 2>&1 || true
}

if ! /usr/bin/curl -fsSL "$BASE_URL/install.sh" -o "$TMP/install.sh"; then
    echo "ERROR: could not download $BASE_URL/install.sh"
    tell_user "MeshAgent could not download the agent. Check this Mac network connection and run the installer again."
    exit 1
fi

# Non-interactive: the walkthrough is scheduled separately, below.
MESH_SKIP_PERMS=1 /bin/bash "$TMP/install.sh"
RC=$?
echo "=== installer exit $RC ==="
[ "$RC" -eq 0 ] || { tell_user "MeshAgent installation failed. See /var/log/meshagent-pkg-install.log for details."; exit "$RC"; }

# Apple's own Screen Sharing helper consent. Runs as root (it reads kvm/vnc.pw,
# root:wheel 0600), returns in a few seconds, and does not wait on us.
[ -x "$D/kvm/meshagent" ] && "$D/kvm/meshagent" -vncprobe >/dev/null 2>&1 || true

# Hand the permission walkthrough to launchd, as the console user, as a one-shot
# job that deletes itself afterwards so it cannot run again at every login.
if [ -n "${CUID:-}" ] && [ "${CUSER:-root}" != "root" ]; then
    HOMEDIR="$(/usr/bin/dscl . -read "/Users/$CUSER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
    if [ -n "$HOMEDIR" ] && [ -d "$HOMEDIR" ]; then
        AGENTS="$HOMEDIR/Library/LaunchAgents"
        SUPPORT="$HOMEDIR/Library/Application Support/MeshAgent"
        PLIST="$AGENTS/ca.exmachina.meshagent.firstrun.plist"
        RUNNER="$SUPPORT/firstrun.sh"
        # Create these only if missing, and hand them to the USER.
        #
        # mkdir -p as root left them root-owned when they did not already exist,
        # and then `ls ~/Library/LaunchAgents` failed with Permission denied for
        # the user who owns the home directory. Worse, the one-shot runner
        # deletes its own plist as the user at the end -- on a root-owned
        # directory that rm fails silently and the job comes back at every
        # single login, which is exactly what the self-deletion exists to stop.
        # Unconditionally, not just when creating: install.sh runs BEFORE this
        # and used to create ~/Library/LaunchAgents as root itself, so guarding
        # on "does not exist" skipped the very case that needed fixing (measured
        # on the VM: the fix was present and the directory was still root-owned,
        # because it already existed by the time this ran). Older installs are in
        # that state too, so repair it whatever we find.
        for dir in "$AGENTS" "$SUPPORT"; do
            [ -d "$dir" ] || /bin/mkdir -p "$dir"
            /usr/sbin/chown "$CUSER" "$dir" 2>/dev/null
            /bin/chmod 755 "$dir" 2>/dev/null
        done

        /bin/cat > "$RUNNER" <<'RUNNEREOF'
#!/bin/bash
# One-shot: ask for the privacy permissions, then remove itself.
/usr/local/mesh_services/meshagent/meshagent/kvm/meshagent -requestperms
P="$HOME/Library/LaunchAgents/ca.exmachina.meshagent.firstrun.plist"
# Delete BEFORE booting out: bootout terminates this script, so anything after
# it would not run and the job would come back at the next login.
/bin/rm -f "$P" "$0"
/bin/launchctl bootout "gui/$(/usr/bin/id -u)/ca.exmachina.meshagent.firstrun" 2>/dev/null
RUNNEREOF

        /bin/cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>ca.exmachina.meshagent.firstrun</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>$RUNNER</string></array>
<key>LimitLoadToSessionType</key><array><string>Aqua</string></array>
<key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>/tmp/meshagent-firstrun.log</string>
<key>StandardErrorPath</key><string>/tmp/meshagent-firstrun.log</string>
</dict></plist>
PLISTEOF

        /usr/sbin/chown "$CUSER" "$RUNNER" "$PLIST"
        /bin/chmod 755 "$RUNNER"
        /bin/chmod 644 "$PLIST"
        /bin/launchctl bootout "gui/$CUID/ca.exmachina.meshagent.firstrun" 2>/dev/null
        if /bin/launchctl bootstrap "gui/$CUID" "$PLIST" 2>/dev/null; then
            echo "permission walkthrough scheduled for $CUSER (one-shot launchd job)"
        else
            echo "WARNING: could not schedule the permission walkthrough"
            tell_user "MeshAgent is installed, but the permission prompts could not be started. Open Terminal and run: sudo bash -c 'curl -fsSL $BASE_URL/install.sh -o /tmp/i.sh; bash /tmp/i.sh'"
        fi
    fi
fi
exit 0
